# Local Service
LUMEN_HOST=127.0.0.1
LUMEN_PORT=4312
# LUMEN_DATA_DIR=D:\path\to\lumen-data

# 外部词汇资料访问代理。Windows 默认会自动读取当前用户的系统代理；
# 其他系统或需要显式覆盖时，可取消下面一行注释。
# LUMEN_HTTPS_PROXY=http://127.0.0.1:7897

# DeepSeek 预设：复制为 .env 后只需要填写 API Key。
LUMEN_AI_PRESET=deepseek
LUMEN_AI_API_KEY=

# 通用 OpenAI-compatible 中转站：将上面的预设改为 openai-compatible，
# 再取消下面两行注释。本地兼容服务不需要密钥时可让 API Key 留空。
# LUMEN_AI_BASE_URL=https://你的中转站地址/v1
# LUMEN_AI_MODEL=你的模型名称
